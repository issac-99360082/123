# Watchpost configuration. Copy to .env and fill in.
# Everything with a default below runs as-is; PLACEHOLDER entries are the ones
# only you can supply before the service can take money. See docs/SETUP.md.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development                    # development | staging | production
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000      # your real domain in production
LOG_LEVEL=INFO
LOG_JSON=true
# REQUIRED IN PRODUCTION. openssl rand -hex 32
# The app refuses to boot in production while this is the default.
SECRET_KEY=dev-insecure-secret-change-me

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./watchpost.db
# DATABASE_URL=postgresql+psycopg2://watchpost:watchpost@db:5432/watchpost

# --- Crawler etiquette / safety ---------------------------------------------
USER_AGENT=WatchpostBot/0.1 (+https://your-domain.example/bot; monitoring on behalf of subscribers)
RESPECT_ROBOTS_TXT=true                    # leave true; this is a compliance control
MIN_SECONDS_BETWEEN_HITS_PER_HOST=20
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=5
# Wall-clock ceiling for ONE check, covering every redirect hop and throttle
# wait. Without it a hostile redirect chain or a trickled response holds a
# worker thread for minutes.
FETCH_TOTAL_DEADLINE_SECONDS=45
ALLOW_PRIVATE_NETWORK_TARGETS=false        # NEVER true on a public deployment (SSRF)

# --- Scheduler --------------------------------------------------------------
# SUSTAINED CAPACITY = CHECK_BATCH_SIZE / SCHEDULER_TICK_SECONDS checks/second.
# This, not CPU, is the ceiling, and it must exceed what your largest plan
# promises: Business (300 monitors on a 60s interval) needs 5 checks/s alone.
# The app logs its capacity at startup and warns when it is below the plans sold.
SCHEDULER_ENABLED=true                     # false on API replicas when a separate worker runs
SCHEDULER_TICK_SECONDS=10
WORKER_CONCURRENCY=16
CHECK_BATCH_SIZE=200
CONSECUTIVE_FAILURES_BEFORE_PAUSE=20
CLAIM_LEASE_SECONDS=180                    # a claim is a lease, so a crash retries
MAX_BATCH_SHARE_PER_USER=0.25              # no account may take more of one batch
EMPTY_CONTENT_CONFIRMATIONS=2              # blank pages must repeat before believed

# --- Retention --------------------------------------------------------------
# Deletes history past each plan's history_days. Without it storage grows
# without bound: one Business customer produces ~1.9 GB of check rows a month.
RETENTION_ENABLED=true
RETENTION_SWEEP_MINUTES=60
RETENTION_BATCH_SIZE=5000

# --- Notifications ----------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
# PLACEHOLDER - email alerts only. Webhook delivery works without any of this.
NOTIFICATION_FROM_EMAIL=alerts@your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Billing (Stripe) -------------------------------------------------------
# PLACEHOLDER - REQUIRED FOR REVENUE. Without these everyone stays on Free and
# the checkout endpoints return 503. https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40
SIGNUP_LIMIT_PER_HOUR_PER_IP=5
LOGIN_MAX_FAILURES=8                       # per (account, source address)
LOGIN_MAX_FAILURES_GLOBAL=50               # per account across all addresses
LOGIN_LOCKOUT_MINUTES=15
# Set true ONLY behind a proxy that OVERWRITES X-Forwarded-For. Exposed
# directly with this on, clients pick their own rate-limit bucket.
TRUST_PROXY_HEADERS=false
