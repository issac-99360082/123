# ---------------------------------------------------------------------------
# Watchpost configuration
#
# Copy to .env and fill in. Everything with a default below runs as-is; the
# entries marked REQUIRED-FOR-REVENUE are the ones you must supply yourself
# before the service can take money. See docs/SETUP.md.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development                    # development | staging | production
DEBUG=false
PUBLIC_BASE_URL=http://localhost:8000      # your real domain in production
LOG_LEVEL=INFO
LOG_JSON=true

# REQUIRED IN PRODUCTION. Generate with: openssl rand -hex 32
# The app refuses to boot in production while this is left at the default.
SECRET_KEY=dev-insecure-secret-change-me

# --- Database ---------------------------------------------------------------
# SQLite is fine for development and for a first few hundred monitors.
DATABASE_URL=sqlite:///./watchpost.db
# Postgres in production (docker-compose sets this for you):
# DATABASE_URL=postgresql+psycopg2://watchpost:watchpost@db:5432/watchpost

# --- Crawler etiquette / safety ---------------------------------------------
USER_AGENT=WatchpostBot/0.1 (+https://your-domain.example/bot; monitoring on behalf of subscribers)
RESPECT_ROBOTS_TXT=true                    # leave true; this is a compliance control
MIN_SECONDS_BETWEEN_HITS_PER_HOST=20
FETCH_TIMEOUT_SECONDS=20
FETCH_MAX_BYTES=2000000
# Wall-clock ceiling for one check, covering every redirect hop and throttle
# wait. Stops a hostile redirect chain from holding a worker thread for minutes.
FETCH_TOTAL_DEADLINE_SECONDS=45
ALLOW_PRIVATE_NETWORK_TARGETS=false        # NEVER set true on a public deployment (SSRF)

# --- Scheduler --------------------------------------------------------------
SCHEDULER_ENABLED=true                     # set false on API replicas when running a separate worker
SCHEDULER_TICK_SECONDS=20
WORKER_CONCURRENCY=8
CHECK_BATCH_SIZE=50
CONSECUTIVE_FAILURES_BEFORE_PAUSE=20

# --- Notifications ----------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5

# PLACEHOLDER - REQUIRED ONLY FOR EMAIL ALERTS.
# Webhook delivery works without any of this. Any SMTP provider will do
# (Postmark, SES, Resend, Mailgun...). Leave blank to disable email alerts.
NOTIFICATION_FROM_EMAIL=alerts@your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Billing (Stripe) -------------------------------------------------------
# PLACEHOLDER - REQUIRED-FOR-REVENUE.
# Without these the app runs fine but everyone stays on the Free plan and the
# checkout endpoints return 503. Get them from https://dashboard.stripe.com
#   STRIPE_SECRET_KEY     : Developers -> API keys (sk_live_... / sk_test_...)
#   STRIPE_WEBHOOK_SECRET : Developers -> Webhooks -> your endpoint (whsec_...)
#   STRIPE_PRICE_*        : Products -> your recurring prices (price_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=40

# Account-creation and sign-in throttles. Signup is the door to free resources;
# login is a password oracle. Both need tighter limits than the general API.
SIGNUP_LIMIT_PER_HOUR_PER_IP=5
LOGIN_MAX_FAILURES=8               # per (account, source address)
LOGIN_MAX_FAILURES_GLOBAL=50       # per account across all addresses
LOGIN_LOCKOUT_MINUTES=15

# Set true ONLY when a reverse proxy in front of this app OVERWRITES
# X-Forwarded-For. Exposed directly with this on, clients pick their own
# rate-limit bucket and every per-IP control is bypassed.
TRUST_PROXY_HEADERS=false

# --- Retention --------------------------------------------------------------
# Deletes check and change history older than each plan's history_days.
# Without it, storage grows without bound: one Business customer at the
# advertised limits produces roughly 1.9 GB of check rows per month.
RETENTION_ENABLED=true
RETENTION_SWEEP_MINUTES=60
RETENTION_BATCH_SIZE=5000
